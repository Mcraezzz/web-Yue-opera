SPRING_PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=yueju
DB_PASSWORD=replace-with-strong-password
DB_NAME=web_yueju
VOLCENGINE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_API_KEY=replace-with-your-server-side-api-key
CHAT_MODEL=doubao-seed-2-0-lite-260428
AI_THINKING_TYPE=disabled
IMAGE_MODEL=doubao-seedream-5-0-260128
CHAT_MAX_OUTPUT_TOKENS=450
CHAT_TIMEOUT_SECONDS=20
CHAT_CACHE_SECONDS=600
MEDIA_ANALYSIS_FILE=/opt/yueju/data/media-analyses.json
MEDIA_ANALYSIS_SCRIPT=/opt/yueju/scripts/generate-media-analysis.py
MEDIA_ANALYSIS_PYTHON=python
MEDIA_ANALYSIS_INPUT=/opt/yueju/media/liangzhu.mp4
RAG_ENABLED=false
MEDIA_LOCAL_ANALYSIS_ENABLED=false
MEDIA_OPERATOR_KEY=
DEMO_ENABLED=false
